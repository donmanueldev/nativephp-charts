{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://donmanueldev.github.io/nativephp-charts/schemas/performance-baseline-v1.json",
  "title": "NativePHP Charts physical performance run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approved",
    "context",
    "measurements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "approved": {
      "type": "boolean"
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "platform",
        "device_model",
        "os_version",
        "build_type",
        "locale",
        "theme",
        "reduced_motion",
        "iterations",
        "aggregation"
      ],
      "properties": {
        "platform": {
          "enum": [
            "ios",
            "android"
          ]
        },
        "device_model": {
          "type": "string",
          "minLength": 1
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "build_type": {
          "enum": [
            "release",
            "profile"
          ]
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "reduced_motion": {
          "type": "boolean"
        },
        "iterations": {
          "type": "integer",
          "minimum": 3
        },
        "aggregation": {
          "const": "median_latency_peak_memory"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chart",
          "points",
          "scenario",
          "latency_ms",
          "memory_mb",
          "slow_frames",
          "payload_bytes",
          "callbacks",
          "expected_callbacks"
        ],
        "properties": {
          "chart": {
            "type": "string",
            "minLength": 1
          },
          "points": {
            "enum": [
              100,
              1000,
              10000
            ]
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "latency_ms": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "memory_mb": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "slow_frames": {
            "type": "integer",
            "minimum": 0
          },
          "payload_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "callbacks": {
            "type": "integer",
            "minimum": 0
          },
          "expected_callbacks": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}