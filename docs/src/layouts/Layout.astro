---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/brand/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/brand/nativephp-charts-32.png`} />
    <link rel="apple-touch-icon" href={`${base}/brand/apple-touch-icon.png`} />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Documentation and examples for native iOS and Android charts in NativePHP Mobile."
    />
    <meta name="theme-color" content="#080808" />
    <title>NativePHP Charts — documentation and examples</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script is:inline src={`${base}/site.js`} defer></script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
