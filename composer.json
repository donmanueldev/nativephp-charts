{
    "name": "donmanueldev/nativephp-charts",
    "description": "Native charts for NativePHP Mobile, rendered with Swift Charts and Jetpack Compose Canvas.",
    "type": "nativephp-ui-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Manuel Duarte",
            "email": "donmanuel@momotombo.dev"
        }
    ],
    "keywords": [
        "nativephp",
        "mobile",
        "charts",
        "swiftui",
        "jetpack-compose"
    ],
    "homepage": "https://github.com/donmanueldev/nativephp-charts",
    "support": {
        "issues": "https://github.com/donmanueldev/nativephp-charts/issues",
        "source": "https://github.com/donmanueldev/nativephp-charts"
    },
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Donmanueldev\\NativephpCharts\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Donmanueldev\\NativephpCharts\\NativePHPChartsServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
