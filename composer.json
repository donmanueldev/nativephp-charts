{
    "name": "donmanueldev/nativephp-charts",
    "description": "Native iOS and Android charts for NativePHP Mobile and Laravel: line, bar, area, scatter, pie, donut, candlestick, radar, progress and heatmap, rendered with Swift Charts and Jetpack Compose.",
    "type": "nativephp-ui-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Manuel Duarte",
            "email": "donmanuel@momotombo.dev"
        }
    ],
    "keywords": [
        "nativephp",
        "nativephp-mobile",
        "nativephp-plugin",
        "laravel",
        "laravel-package",
        "charts",
        "chart",
        "mobile-charts",
        "native-charts",
        "swift-charts",
        "swiftui",
        "jetpack-compose",
        "android",
        "ios",
        "line-chart",
        "bar-chart",
        "pie-chart",
        "candlestick",
        "radar-chart",
        "heatmap"
    ],
    "homepage": "https://donmanueldev.github.io/nativephp-charts/",
    "support": {
        "issues": "https://github.com/donmanueldev/nativephp-charts/issues",
        "source": "https://github.com/donmanueldev/nativephp-charts",
        "docs": "https://donmanueldev.github.io/nativephp-charts/"
    },
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.0",
        "nativephp/mobile-ui": "^0.4"
    },
    "autoload": {
        "psr-4": {
            "Donmanueldev\\NativephpCharts\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Donmanueldev\\NativephpCharts\\NativePHPChartsServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
