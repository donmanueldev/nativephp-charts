{
    "name": "donmanueldev/nativephp-charts",
    "description": "Native chart components for NativePHP Mobile, rendered with SwiftUI and Jetpack Compose.",
    "type": "nativephp-ui-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Manuel Duarte",
            "email": "donmanuel@momotombo.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Donmanueldev\\NativephpCharts\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Donmanueldev\\NativephpCharts\\NativePHPChartsServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}